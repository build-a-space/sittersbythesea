---
import { SITE_KEY, city, href, link, bookHref } from '../lib/site.js';
import { business } from '../data/business.js';
import Icon from './Icon.astro';

const current = Astro.url.pathname;
const nav = SITE_KEY === 'main'
  ? [
      { name: 'Services', url: href('/services/') },
      { name: 'About', url: href('/about/') },
      { name: 'Reviews', url: href('/reviews/') },
      { name: 'Contact', url: href('/contact/') },
    ]
  : [
      { name: 'Home', url: href('/') },
      { name: 'Services', url: href('/services/') },
      { name: 'Service areas', url: href('/service-areas/') },
      { name: 'About us', url: link('main', '/about/') },
      { name: 'Reviews', url: link('main', '/reviews/') },
    ];
const phone = city?.phone ?? business.phone;
const phoneHref = city?.phoneHref ?? business.phoneHref;
---
<a class="skip" href="#main">Skip to content</a>
<div class="utility">
  <div class="wrap">
    <div class="utility__group">
      {SITE_KEY === 'vb' ? <span class="utility__here">Virginia Beach, VA</span> : <a href={link('vb')}>Virginia Beach, VA</a>}
      {SITE_KEY === 'chs' ? <span class="utility__here">Charleston, SC</span> : <a href={link('chs')}>Charleston, SC</a>}
      {SITE_KEY !== 'main' && <a href={link('main')}>Main site</a>}
    </div>
    <div class="utility__group">
      <a href={`tel:${phoneHref}`}>{phone}</a>
      <a class="utility__email" href={`mailto:${business.email}`}>{business.email}</a>
      {business.timeToPet && <a href={business.timeToPet}>Client login</a>}
    </div>
  </div>
</div>
<header class="header">
  <div class="wrap">
    <a class="brand" href={href('/')} aria-label={city ? `Sitters by the Sea ${city.name} home` : 'Sitters by the Sea home'}>
      <img src="/images/brand/logo.png" alt="Sitters by the Sea: Sit. Stay. Go. Play." width="500" height="159" />
      {city && <span class="brand__city">{city.name}, {city.state}</span>}
    </a>
    <nav class="nav" aria-label="Main">
      <ul class="nav__links">
        {nav.map((item) => <li><a href={item.url} aria-current={item.url === current ? 'page' : undefined}>{item.name}</a></li>)}
      </ul>
      <a class="btn btn--red btn--sm" href={bookHref()}>Book a meet &amp; greet</a>
    </nav>
    <details class="menu">
      <summary><Icon name="menu" /> Menu</summary>
      <div class="menu__panel">
        {nav.map((item) => <a href={item.url}>{item.name}</a>)}
        <a class="btn btn--red" href={bookHref()}>Book a meet &amp; greet</a>
      </div>
    </details>
  </div>
</header>
