---
import { services } from '../data/services.js';
import { bookHref } from '../lib/site.js';
import Icon from './Icon.astro';
interface Props { cityName?: string }
const { cityName } = Astro.props;
---
<div class="svc-list">
  {services.map((s) => (
    <article class="svc" id={s.id}>
      <div class="svc__name">
        <span class="card__label">{s.label}</span>
        <h2 style="font-size:1.55rem">{s.name}</h2>
      </div>
      <div class="svc__body">
        <p>{s.body}</p>
        <div><a class="textlink" href={bookHref()}>Book {s.name.toLowerCase()}{cityName ? ` in ${cityName}` : ''} <Icon name="arrow" size={16} /></a></div>
      </div>
      <ul class="svc__inc" aria-label={`${s.name} includes`}>
        {s.includes.map((i) => <li><Icon name="check" size={14} />{i}</li>)}
      </ul>
    </article>
  ))}
</div>
