---
import { business } from '../data/business.js';
---
<div class="badges">
  <div class="badge"><span class="badge__mark">NAPPS</span><span class="badge__text"><b>NAPPS member</b>National Association of Professional Pet Sitters</span></div>
  <div class="badge"><span class="badge__mark">PSI</span><span class="badge__text"><b>PSI member</b>Pet Sitters International</span></div>
  <div class="badge"><span class="badge__mark" style="background:#e6f4ea;color:#1c7c3b">Fave</span><span class="badge__text"><b>Nextdoor Neighborhood Fave</b>2021, 2022 &amp; 2023</span></div>
  <div class="badge"><span class="badge__mark" style="background:#fff"><img src={business.awards[1].image} alt="Coastal Virginia Magazine" width="150" height="150" loading="lazy" /></span><span class="badge__text"><b>CoVa Magazine nominee</b>Best Pet Sitting Business on the Southside, 2021–2023</span></div>
</div>
