---
import Base from '../../../shared/layouts/Base.astro';
import PageHead from '../../../shared/components/PageHead.astro';
import Icon from '../../../shared/components/Icon.astro';
import { href, link, MODE } from '../../../shared/lib/site.js';
import { business } from '../../../shared/data/business.js';
import { cities } from '../../../shared/data/cities.js';
---
<Base
  title="Contact & Book a Meet and Greet | Sitters by the Sea"
  description="Book a free meet & greet with a Sitters by the Sea pet sitter in Virginia Beach or Charleston. Call (757) 348-0411 or send us a message."
  crumbs={[{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }]}
>
  <PageHead
    eyebrow="Contact"
    title="Book a meet & greet"
    lead="Tell us about your pets and the care you need. We reply within one business day, usually sooner."
    crumbs={[{ name: 'Home', url: href('/') }, { name: 'Contact' }]}
  />

  <section class="section">
    <div class="wrap contact">
      <div class="stack-lg">
        <dl class="dl">
          <div><dt>Phone</dt><dd><a href={`tel:${business.phoneHref}`}>{business.phone}</a></dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${business.email}`}>{business.email}</a></dd></div>
          <div><dt>Office hours</dt><dd>{business.officeHours}</dd></div>
          <div><dt>Pet sitting hours</dt><dd>{business.sittingHours}</dd></div>
        </dl>
        {Object.values(cities).map((c) => (
          <div class="panel">
            <h3>{c.name}, {c.state}</h3>
            <p>{c.areas.map((a) => a.name).join(', ')}</p>
            <a class="textlink" href={link(c.key, '/service-areas/')}>See {c.name} service areas <Icon name="arrow" size={16} /></a>
          </div>
        ))}
      </div>

      <form class="form" id="book" method="post" action="/api/contact" data-demo={MODE === 'demo' ? '' : undefined}>
        <div class="stack" style="gap:6px">
          <h2 style="font-size:1.7rem">Tell us about your pets</h2>
          <p class="form__note">Fields marked * are required.</p>
        </div>
        <div class="form__row">
          <div class="field"><label for="name">Your name *</label><input id="name" name="name" autocomplete="name" required /></div>
          <div class="field"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" autocomplete="tel" /></div>
        </div>
        <div class="form__row">
          <div class="field"><label for="email">Email *</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field">
            <label for="city">City *</label>
            <select id="city" name="city" required>
              <option value="">Choose your city</option>
              <option value="vb">Virginia Beach, VA</option>
              <option value="chs">Charleston, SC</option>
            </select>
          </div>
        </div>
        <div class="form__row">
          <div class="field">
            <label for="service">What do you need?</label>
            <select id="service" name="service">
              <option>Dog walks</option>
              <option>Drop-in pet visits</option>
              <option>Overnight care</option>
              <option>Live-in 24/7 care</option>
              <option>Pet taxi</option>
              <option>I want to join the team</option>
            </select>
          </div>
          <div class="field"><label for="pets">Your pets</label><input id="pets" name="pets" placeholder="e.g. 2 dogs, 1 cat" /></div>
        </div>
        <div class="field"><label for="message">Dates and details</label><textarea id="message" name="message" placeholder="When do you need care, and anything we should know?"></textarea></div>
        <label style="display:flex;gap:10px;align-items:center;font-size:.95rem"><input type="checkbox" name="military" value="yes" style="width:18px;height:18px" /> I'm active duty, a veteran or deploying (20% off)</label>
        <div><button class="btn btn--red" type="submit">Send my request</button></div>
        <p class="form__status" role="status" hidden></p>
      </form>
    </div>
  </section>

  <script is:inline>
    (function () {
      var form = document.getElementById('book');
      var status = form.querySelector('.form__status');
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (form.hasAttribute('data-demo')) {
          status.textContent = 'Online requests are almost ready. For now, please call or text (757) 348-0411 or email info@sittersbythesea.net.';
          status.hidden = false;
          return;
        }
        fetch(form.action, { method: 'POST', body: new URLSearchParams(new FormData(form)), headers: { Accept: 'application/json' } })
          .then(function (r) { if (!r.ok) throw new Error(); form.reset(); status.textContent = 'Thanks! We got your request and will be in touch within one business day.'; })
          .catch(function () { status.textContent = 'Your message did not send. Please call (757) 348-0411 or email info@sittersbythesea.net.'; })
          .finally(function () { status.hidden = false; });
      });
    })();
  </script>
</Base>
